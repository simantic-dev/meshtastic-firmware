// RAK4631 radio: SX1262 on SPIM3 (SCK P0.03, MISO P0.29, MOSI P0.30), NSS P1.10 (Arduino 42),
// BUSY P1.14 (46), DIO1 P1.15 (47). Outputs: 0=BUSY 1=DIO1.
sx1262: SPI.ScriptedSpiSlave @ spim3
    file: "sim/sx/sx1262.py"
    numberOfGpios: 4
    0 -> gpio1@14
    1 -> gpio1@15

gpio1:
    10 -> sx1262@0
